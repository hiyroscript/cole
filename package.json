{
  "name": "cole",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:knowledge": "tsx scripts/validate-knowledge.ts",
    "build": "tsc --noEmit && vite build && node scripts/semantic-assets.mjs && node scripts/service-worker.mjs",
    "build:extension": "vite build --mode extension && node scripts/extension.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:extension": "node --import tsx tests/extension.mjs",
    "test:deep:real": "node --import tsx scripts/smoke-deep.mjs",
    "format": "prettier --write src extension scripts tests *.ts *.json index.html .github/workflows/*.yml docs/*.md README.md",
    "test:madon:real": "node scripts/smoke-madon.mjs",
    "check:brand": "tsx scripts/check-brand.ts",
    "evaluate:gamma": "tsx scripts/evaluate-gamma.ts",
    "test:gamma:real": "node --import tsx scripts/smoke-gamma.mjs",
    "measure:gamma": "node scripts/measure-gamma.mjs",
    "build:icons": "node scripts/brand-assets.mjs",
    "evaluate:gamma3": "tsx scripts/evaluate-gamma3.ts",
    "calibrate:gamma": "tsx scripts/calibrate-gamma.ts",
    "evaluate:intelligence": "tsx scripts/evaluate-intelligence.ts",
    "generate:workflow-nodes": "tsx scripts/generate-workflow-nodes.ts",
    "check:payload": "node scripts/check-payload.mjs",
    "evaluate:semantic-heldout": "tsx scripts/evaluate-semantic-heldout.ts",
    "evaluate:gamma4": "tsx scripts/evaluate-gamma4.ts",
    "evaluate:capabilities": "tsx scripts/evaluate-capabilities.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@mlc-ai/web-llm": "0.2.86",
    "fflate": "0.8.3",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "4.0.1",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@webgpu/types": "0.1.69",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.0.0",
    "prettier": "^3.9.10",
    "sharp": "0.35.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "overrides": {
    "sharp": "$sharp"
  }
}
