{
  "name": "varek",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:knowledge": "tsx scripts/validate-knowledge.ts",
    "build": "tsc --noEmit && vite build && node scripts/service-worker.mjs",
    "build:extension": "vite build --mode extension && node scripts/extension.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:extension": "node tests/extension.mjs",
    "format": "prettier --write src extension scripts tests *.ts *.json index.html .github/workflows/*.yml docs/*.md README.md",
    "test:madon:real": "node scripts/smoke-madon.mjs"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.86",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@webgpu/types": "0.1.69",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.0.0",
    "prettier": "^3.9.10",
    "sharp": "^0.34.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
